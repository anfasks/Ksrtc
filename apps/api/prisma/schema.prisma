generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JourneyStatus {
  SCHEDULED
  BOARDING
  ON_ROAD
  ARRIVED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TrackingEvent {
  CREATED
  REFRESHED
  SENT_NOTIFICATION
  EXPIRED
}

model User {
  id            String    @id @default(uuid())
  phone         String?   @unique
  email         String?   @unique
  otpHash       String?
  otpExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  issuedLinks   TrackingLink[] @relation("IssuedLinks")
}

model Stop {
  id                  String   @id @default(uuid())
  name                String
  lat                 Float
  lng                 Float
  address             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  routesOrigin        Route[]  @relation("RouteOrigin")
  routesDestination   Route[]  @relation("RouteDestination")
}

model Route {
  id                 String   @id @default(uuid())
  code               String   @unique
  originStopId       String
  destinationStopId  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  journeys           Journey[]

  originStop         Stop     @relation("RouteOrigin", fields: [originStopId], references: [id])
  destinationStop    Stop     @relation("RouteDestination", fields: [destinationStopId], references: [id])
}

model Vehicle {
  id             String   @id @default(uuid())
  registrationNo String   @unique
  capacity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  journeys       Journey[]
}

model Journey {
  id             String         @id @default(uuid())
  routeId        String
  vehicleId      String?
  serviceDate    DateTime
  departureTime  DateTime
  arrivalTime    DateTime
  status         JourneyStatus  @default(SCHEDULED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookings       Booking[]
  trackingLinks  TrackingLink[]

  route          Route          @relation(fields: [routeId], references: [id])
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
}

model Booking {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  pnr        String        @unique
  userId     String
  journeyId  String
  seatNo     String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  journey    Journey       @relation(fields: [journeyId], references: [id])
}

model TrackingLink {
  id            String          @id @default(uuid())
  journeyId     String
  shareUrl      String
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime
  issuedById    String
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  audits        TrackingAudit[]

  journey       Journey         @relation(fields: [journeyId], references: [id])
  issuedBy      User            @relation("IssuedLinks", fields: [issuedById], references: [id])
}

model TrackingAudit {
  id              String         @id @default(uuid())
  trackingLinkId  String
  event           TrackingEvent
  payload         Json?
  createdAt       DateTime       @default(now())

  trackingLink    TrackingLink   @relation(fields: [trackingLinkId], references: [id])
}
